{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectOutput",
  "description": "`direct` role output (§9, §13): one scene's beats in narration order. The server numbers them 1..n and rescales their target_chars to sum to the scene's, keeping the model's proportions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats"],
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "DirectBeat",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "techniques",
          "pov",
          "mode",
          "focus",
          "density",
          "tension",
          "target_chars"
        ],
        "properties": {
          "summary": {
            "description": "What happens in the beat, one or two sentences.",
            "type": "string",
            "minLength": 1
          },
          "techniques": {
            "description": "Cards the beat realizes, among the scene's chosen and serial cards (narrowed per call).",
            "type": "array",
            "items": {
              "$ref": "../common/technique-id.json"
            }
          },
          "pov": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "$ref": "../direction/beat-mode.json"
          },
          "focus": {
            "$ref": "../direction/beat-focus.json"
          },
          "density": {
            "$ref": "../direction/beat-density.json"
          },
          "tension": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "target_chars": {
            "description": "The beat's share of the scene in characters (a proportion: the server rescales).",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
