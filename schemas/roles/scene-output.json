{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneOutput",
  "description": "`scene` role output (§9, §13): the episode split into scenes in story order. The server drops scenes whose source is not one of the episode's structure stage names, renumbers the rest 1..n and drops repeated tags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "OutputScene",
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "source", "summary", "devices", "effects", "situations"],
        "properties": {
          "scene": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "description": "The episode structure stage the scene comes from (§9 `source` = episode.stage).",
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "description": "What happens, in one or two sentences.",
            "type": "string",
            "minLength": 1
          },
          "devices": {
            "title": "SceneDevices",
            "description": "A yes/no answer per scene device (technique-device.json, same keys in the same order), answered before the tags; code recommends the cards sharing the devices answered true (§9).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "knowledge_gap",
              "hidden_secret",
              "mystery",
              "reveal",
              "reversal",
              "plant",
              "payoff",
              "foretold",
              "deadline",
              "dilemma",
              "eerie_threat",
              "action",
              "held_moment",
              "past_told",
              "embedded",
              "time_skip",
              "revisit",
              "repetition",
              "unspoken",
              "verbal_clash",
              "misunderstanding",
              "overhear",
              "crowd_voice",
              "first_appearance",
              "realization",
              "confession",
              "delayed_outcome",
              "relationship_shift",
              "humor",
              "satire",
              "new_place",
              "world_rules",
              "simultaneous",
              "ordinary_life",
              "aftermath",
              "contrast",
              "loss",
              "meaningful_object",
              "differing_views",
              "threshold",
              "release"
            ],
            "properties": {
              "knowledge_gap": {
                "type": "boolean"
              },
              "hidden_secret": {
                "type": "boolean"
              },
              "mystery": {
                "type": "boolean"
              },
              "reveal": {
                "type": "boolean"
              },
              "reversal": {
                "type": "boolean"
              },
              "plant": {
                "type": "boolean"
              },
              "payoff": {
                "type": "boolean"
              },
              "foretold": {
                "type": "boolean"
              },
              "deadline": {
                "type": "boolean"
              },
              "dilemma": {
                "type": "boolean"
              },
              "eerie_threat": {
                "type": "boolean"
              },
              "action": {
                "type": "boolean"
              },
              "held_moment": {
                "type": "boolean"
              },
              "past_told": {
                "type": "boolean"
              },
              "embedded": {
                "type": "boolean"
              },
              "time_skip": {
                "type": "boolean"
              },
              "revisit": {
                "type": "boolean"
              },
              "repetition": {
                "type": "boolean"
              },
              "unspoken": {
                "type": "boolean"
              },
              "verbal_clash": {
                "type": "boolean"
              },
              "misunderstanding": {
                "type": "boolean"
              },
              "overhear": {
                "type": "boolean"
              },
              "crowd_voice": {
                "type": "boolean"
              },
              "first_appearance": {
                "type": "boolean"
              },
              "realization": {
                "type": "boolean"
              },
              "confession": {
                "type": "boolean"
              },
              "delayed_outcome": {
                "type": "boolean"
              },
              "relationship_shift": {
                "type": "boolean"
              },
              "humor": {
                "type": "boolean"
              },
              "satire": {
                "type": "boolean"
              },
              "new_place": {
                "type": "boolean"
              },
              "world_rules": {
                "type": "boolean"
              },
              "simultaneous": {
                "type": "boolean"
              },
              "ordinary_life": {
                "type": "boolean"
              },
              "aftermath": {
                "type": "boolean"
              },
              "contrast": {
                "type": "boolean"
              },
              "loss": {
                "type": "boolean"
              },
              "meaningful_object": {
                "type": "boolean"
              },
              "differing_views": {
                "type": "boolean"
              },
              "threshold": {
                "type": "boolean"
              },
              "release": {
                "type": "boolean"
              }
            }
          },
          "effects": {
            "description": "Effects the scene wants the reader to feel.",
            "type": "array",
            "items": {
              "$ref": "../technique/technique-effect.json"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "situations": {
            "description": "Situations the scene is in.",
            "type": "array",
            "items": {
              "$ref": "../technique/technique-situation.json"
            },
            "minItems": 1,
            "maxItems": 3
          }
        }
      }
    }
  }
}
