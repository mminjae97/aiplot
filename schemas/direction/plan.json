{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectionPlan",
  "description": "An episode's direction plan (§9): chapters in order, each chapter's scenes in narration order, each scene's beats in narration order. Confirmed when every scene is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode", "chapters"],
  "properties": {
    "episode": {
      "$ref": "../common/card-id.json"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "title": "PlanChapter",
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter", "target_chars", "scenes"],
        "properties": {
          "chapter": {
            "description": "1..n within the episode; the chapter is cut after its last scene.",
            "type": "integer",
            "minimum": 1
          },
          "target_chars": {
            "description": "Characters incl. spaces; the chapter's scene targets sum to it.",
            "type": "integer",
            "minimum": 1
          },
          "scenes": {
            "description": "In narration order.",
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/PlanScene"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "PlanScene": {
      "title": "PlanScene",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "status",
        "source",
        "summary",
        "core",
        "target_chars",
        "ai_devices",
        "sub_devices",
        "devices",
        "effects",
        "situations",
        "recommended",
        "chosen",
        "reveal",
        "beats"
      ],
      "properties": {
        "scene": {
          "description": "Story-order number from the `scene` role (1..n).",
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "./scene-status.json"
        },
        "source": {
          "description": "The episode structure stage the scene comes from.",
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "description": "What the scene must give the reader, one sentence.",
          "type": "string",
          "minLength": 1
        },
        "target_chars": {
          "description": "Characters incl. spaces; the scene's beat targets sum to it.",
          "type": "integer",
          "minimum": 1
        },
        "ai_devices": {
          "description": "The devices the scene role answered main (pre-checked for the user).",
          "type": "array",
          "items": {
            "$ref": "../technique/technique-device.json"
          }
        },
        "sub_devices": {
          "description": "The devices the scene role answered sub (first among the unchecked).",
          "type": "array",
          "items": {
            "$ref": "../technique/technique-device.json"
          }
        },
        "devices": {
          "description": "The user's checked devices (ai_devices until corrected); the recommendation uses them.",
          "type": "array",
          "items": {
            "$ref": "../technique/technique-device.json"
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "../technique/technique-effect.json"
          }
        },
        "situations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "../technique/technique-situation.json"
          }
        },
        "recommended": {
          "description": "The scene's recommended cards in rank order with what they share with it.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "title": "PlanRecommendation",
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "technique", "devices", "effects", "situations"],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "technique": {
                "$ref": "../common/technique-id.json"
              },
              "devices": {
                "type": "array",
                "items": {
                  "$ref": "../technique/technique-device.json"
                }
              },
              "effects": {
                "type": "array",
                "items": {
                  "$ref": "../technique/technique-effect.json"
                }
              },
              "situations": {
                "type": "array",
                "items": {
                  "$ref": "../technique/technique-situation.json"
                }
              }
            }
          }
        },
        "chosen": {
          "description": "The user's cards for the scene (1-3 to direct it; empty before the pick).",
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "../common/technique-id.json"
          }
        },
        "reveal": {
          "description": "What the scene reveals to the reader (from `arrange`), possibly nothing.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "beats": {
          "description": "In narration order; empty until the scene is directed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanBeat"
          }
        }
      }
    },
    "PlanBeat": {
      "title": "PlanBeat",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "summary",
        "techniques",
        "pov",
        "mode",
        "focus",
        "density",
        "tension",
        "target_chars"
      ],
      "properties": {
        "order": {
          "description": "1..n within the scene, set by the server.",
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "description": "What happens in the beat (the write role's instruction).",
          "type": "string",
          "minLength": 1
        },
        "techniques": {
          "description": "The scene's chosen or serial cards this beat realizes.",
          "type": "array",
          "items": {
            "$ref": "../common/technique-id.json"
          }
        },
        "pov": {
          "description": "Point of view, e.g. 테오 1인칭, 3인칭 관찰.",
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "./beat-mode.json"
        },
        "focus": {
          "$ref": "./beat-focus.json"
        },
        "density": {
          "$ref": "./beat-density.json"
        },
        "tension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "target_chars": {
          "description": "Characters incl. spaces, set by the server from the model's proportions.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
