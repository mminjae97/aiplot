{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneBeatsUpdate",
  "description": "PUT /plans/{planId}/scenes/{scene}/beats: the user's beats for a directed scene in narration order (§9). The server numbers them 1..n and rescales target_chars (weights) to the scene's; techniques must be the scene's chosen or serial cards (422 BEATS_INVALID).",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats"],
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "BeatEdit",
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "techniques", "pov", "mode", "focus", "density", "tension", "target_chars"],
        "properties": {
          "summary": { "type": "string", "pattern": "\\S" },
          "techniques": {
            "type": "array",
            "items": { "$ref": "../common/technique-id.json" }
          },
          "pov": { "type": "string", "pattern": "\\S" },
          "mode": { "$ref": "./beat-mode.json" },
          "focus": { "$ref": "./beat-focus.json" },
          "density": { "$ref": "./beat-density.json" },
          "tension": { "type": "integer", "minimum": 1, "maximum": 5 },
          "target_chars": {
            "description": "A weight: the server rescales the beats' to sum to the scene's target.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
