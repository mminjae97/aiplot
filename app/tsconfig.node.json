{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "tests/e2e/**/*.ts",
    "src/strings/**/*.ts"
  ]
}
